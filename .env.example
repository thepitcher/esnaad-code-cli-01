# Esnaad Code Configuration
# Copy this file to .env and fill in your values

# Working directory for file operations (defaults to current directory)
ESNAAD_WORKING_DIRECTORY=C:\Projects\my-project

# Debug mode (true/false)
ESNAAD_DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
ESNAAD_LOG_LEVEL=INFO

# =============================================================================
# LLM Settings
# =============================================================================

# Base URL for OpenAI-compatible API (Open WebUI, etc.)
ESNAAD_LLM__BASE_URL=http://localhost:3000/api

# API key (if required by your LLM provider)
ESNAAD_LLM__API_KEY=

# Model name to use
ESNAAD_LLM__MODEL=gpt-4

# Temperature for generation (0.0 - 2.0)
ESNAAD_LLM__TEMPERATURE=0.7

# Maximum tokens to generate
ESNAAD_LLM__MAX_TOKENS=4096

# Request timeout in seconds
ESNAAD_LLM__TIMEOUT=60.0

# Verify SSL/TLS certificates (set to false for self-signed certs)
ESNAAD_LLM__VERIFY_SSL=true

# =============================================================================
# Orchestrator Settings
# =============================================================================

# Maximum iterations for the main agent loop
ESNAAD_ORCHESTRATOR__MAX_ITERATIONS=50

# Timeout for the entire task in seconds
ESNAAD_ORCHESTRATOR__TIMEOUT_SECONDS=300

# Enable interactive clarifications (true/false)
ESNAAD_ORCHESTRATOR__ENABLE_CLARIFICATIONS=true

# Maximum clarification questions
ESNAAD_ORCHESTRATOR__MAX_CLARIFICATION_QUESTIONS=5

# =============================================================================
# Sub-Agent Settings
# =============================================================================

# Maximum iterations for sub-agent loops
ESNAAD_SUBAGENT__MAX_ITERATIONS=20

# Timeout per subtask in seconds
ESNAAD_SUBAGENT__TIMEOUT_SECONDS=120

# Maximum retries for failed subtasks
ESNAAD_SUBAGENT__MAX_RETRIES=2

# =============================================================================
# Tool Settings
# =============================================================================

# Maximum file size to read (bytes)
ESNAAD_TOOLS__MAX_FILE_SIZE_BYTES=1000000

# Maximum output characters from tools
ESNAAD_TOOLS__MAX_OUTPUT_CHARS=50000

# Command execution timeout in seconds
ESNAAD_TOOLS__COMMAND_TIMEOUT=60

# Maximum search results
ESNAAD_TOOLS__SEARCH_MAX_RESULTS=100
